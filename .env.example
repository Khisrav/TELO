# Required
BOT_TOKEN=123456:ABC-DEF...
SPECIALIST_TG_ID=123456789
ADMIN_TELEGRAM_ID=123456789

# Optional
SPECIALIST_PHONE=79001234567
SMSRU_API=
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/...

# Paste full service account JSON on one line (Railway variable)
GOOGLE_CREDENTIALS_JSON=

# Persistent SQLite on Railway: mount a volume at /data and set:
DATABASE_PATH=/data/bookings.db

# Optional Redis (Railway Redis plugin sets REDIS_URL automatically)
REDIS_URL=

# Asset paths (defaults: assets/karina.jpg, assets/karina_about.jpg)
START_PHOTO=
ABOUT_PHOTO=

# Set by Railway automatically
PORT=8080
